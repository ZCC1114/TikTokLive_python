[Unit]
Description=TikTok LIVE WebSocket (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=tiktoklive
Group=tiktoklive
WorkingDirectory=/opt/tiktoklive/slots/%i
EnvironmentFile=/etc/tiktoklive/overseas.env
EnvironmentFile=/etc/tiktoklive/%i.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tiktoklive/slots/%i/.venv/bin/python -m uvicorn examples.fastapi_ws_server:app --host 127.0.0.1 --port ${APP_PORT} --workers 1 --ws-max-size 1024 --ws-max-queue 16 --timeout-graceful-shutdown 40
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65536
UMask=0077
StateDirectory=tiktoklive
LogsDirectory=tiktoklive
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
