[Unit]
Description=FastSort Python Service (TikTokLive FastAPI WebSocket)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/fastsort/TikTokLive-python
ExecStart=/home/ec2-user/miniconda3/envs/tiktoklive/bin/uvicorn examples.fastapi_ws_server:app --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5
SuccessExitStatus=143
# Deployment credentials belong in a private systemd environment file.


[Install]
WantedBy=multi-user.target
