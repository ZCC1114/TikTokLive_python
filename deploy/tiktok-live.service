[Unit]
Description=TikTok LIVE WebSocket service
Wants=network-online.target
After=network-online.target redis-server.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=tiktoklive
Group=tiktoklive
WorkingDirectory=/opt/tiktoklive/current
EnvironmentFile=/etc/tiktoklive/service.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tiktoklive/current/.venv/bin/python -m uvicorn examples.fastapi_ws_server:app --host 127.0.0.1 --port 8765 --workers 1 --timeout-graceful-shutdown 40
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65536
UMask=0077
StateDirectory=tiktoklive
LogsDirectory=tiktoklive
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
